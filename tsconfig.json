{
  "compilerOptions": {
    "target": "ES2022",

    "module": "ESNext",

    "moduleResolution": "Bundler",

    "lib": [
      "ES2022",
      "WebWorker"
    ],

    "types": [
      "@cloudflare/workers-types"
    ],

    "strict": true,

    "noEmit": true,

    "skipLibCheck": true,

    "resolveJsonModule": true,

    "isolatedModules": true,

    "esModuleInterop": true
  },

  "include": [
    "src/**/*.ts"
  ]
}
